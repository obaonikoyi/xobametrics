# Copy names to the backend host's secure environment settings.
# Never commit real credentials. Use a separate production database.
MONGO_URL=
DB_NAME=xobametrics
JWT_SECRET=
FRONTEND_URL=https://metrics.3xoba.com
CORS_ORIGINS=https://metrics.3xoba.com,https://xobametrics-gamma.vercel.app
PUBLIC_API_URL=https://xobametrics-production.up.railway.app

# YouTube Data API / Google OAuth web application credentials.
# Authorized redirect URI must match YOUTUBE_REDIRECT_URI exactly.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://xobametrics-production.up.railway.app/api/youtube/callback
# Separate long random secret used to encrypt stored OAuth access/refresh tokens.
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# SoundCloud OAuth 2.1 application. PKCE is generated per connection.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=https://xobametrics-production.up.railway.app/api/soundcloud/callback
SOUNDCLOUD_TOKEN_ENCRYPTION_KEY=

# AI explanations. Both are required for the AI panel; without them the
# backend still serves every computed analytic, and the panel reports that it
# is not configured. Set AI_MODEL only to a model you have verified your key
# can call -- a model name in source is not evidence the provider serves it.
OPENAI_API_KEY=
AI_MODEL=

# Directory for archived CSV uploads. Unset means uploads are not archived;
# imports still work. Must be on a persistent volume to survive a redeploy.
UPLOAD_ARCHIVE_DIR=
# Sign-in delegated to the scaffolding vendor's demo host. Off by default:
# it signs in whatever email that remote returns, with nothing verified here.
# Leave it false and use email/password, or build a real Google OAuth flow.
ENABLE_EMERGENT_GOOGLE_LOGIN=false

ENABLE_SCHEDULED_SYNC=false
ENABLE_DEMO_SEED=false
# Optional administrator bootstrap. Do not reuse any published sample password.
# ADMIN_EMAIL=your-admin-email
# ADMIN_PASSWORD=your-unique-secret
